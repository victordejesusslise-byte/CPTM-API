# Copie para .env (na mesma pasta) e preencha. O .env NUNCA vai para o git.
# Formato: Secao__Chave=valor (o .NET lê "__" como ":" da configuração).

# Banco: SQL Server Express deste PC, com o login do Windows (nenhuma senha de banco em arquivo).
ConnectionStrings__ViaPermanente='Server=localhost\SQLEXPRESS;Database=ViaPermanente;Trusted_Connection=True;TrustServerCertificate=True'
# Alternativa com login do SQL Server:
# ConnectionStrings__ViaPermanente='Server=localhost\SQLEXPRESS;Database=ViaPermanente;User Id=via_app;Password=TROQUE;TrustServerCertificate=True'

# Chave do JWT: pelo menos 32 caracteres aleatórios.
Jwt__Chave='TROQUE-por-uma-chave-aleatoria-de-64-caracteres'

# Supervisor criado na primeira subida, só se o banco ainda não tiver nenhum usuário.
# Depois do primeiro login, cada pessoa recebe a própria senha pelo cadastro de usuários.
UsuarioInicial__Nome='Supervisor inicial'
UsuarioInicial__Email='supervisor@viapermanente.local'
UsuarioInicial__Senha='TROQUE-senha-com-8-ou-mais'

# Chave do carro de inspeção: ele manda a passagem noturna no cabeçalho X-Chave-Carro.
Integracao__ChaveCarro='TROQUE-por-uma-chave-aleatoria'

# SQL Server do Docker (usuário sa): só o docker compose usa. Letras maiúsculas, minúsculas e números, 12 ou mais.
Banco__SenhaSa=troque-por-uma-senha-forte
